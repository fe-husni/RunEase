# Firebase — isi dari Firebase Console > Project Settings > General > Your apps > SDK setup & configuration > Config
# WAJIB isi 7 field di bawah setelah buat project (lihat FIREBASE_SETUP.md Fase A2)
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXX

# App
VITE_APP_VERSION=1.0.0

# Catatan Opsi A (Spark gratis): Storage tidak dipakai di MVP (nada via Oscillator), jadi STORAGE_BUCKET boleh isi tapi tidak akan di-deploy.
# Analytics ON: MEASUREMENT_ID wajib isi G-... jika Analytics enable, jika kosong analytics akan nonaktif otomatis (tidak error).
